function normalizeTimestamp(timestamp) {
    if (timestamp.toString().length === 10) {
        return timestamp * 1000; 
    }
    return timestamp; 
}

let v = function(o) {
    let p = o.match(/[?&]id=([a-zA-Z0-9_.]+)/);
    if (p && p[1]) {
        let c = p[1];
        return /^[a-zA-Z0-9_.]+$/.test(c) ? c : null
    }
    return /^[a-zA-Z0-9_.]+$/.test(o) ? o : null
};


window.onload = function () {
    let genButton = document.getElementById("genlink");
    genButton && genButton.addEventListener("click", function () {
      
        genButton.disabled = true;
        genButton.style.backgroundColor = "#ccc";

        let packageName = v(document.getElementById("package").value.trim()),
            vc = document.getElementById("vc").value,
            resultsContainer = document.getElementById("results-container"),
            progressContainer = document.getElementById("progress-container"),
            progressBar = document.getElementById("progress-bar"),
            versionDisplay = document.getElementById("version-display");
		
       
        if (!packageName) {
            resultsContainer.innerHTML = "<p>Please enter a valid package name.</p>";
            genButton.disabled = false;
            genButton.style.backgroundColor = "";
            return;
        }

        versionDisplay.style.display = "none";
        progressContainer.style.display = "block";
        progressBar.style.width = "0%";
        progressBar.innerText = "0%";
        resultsContainer.innerHTML = "<p>Processing... Please wait.</p>";       
        let xhr = new XMLHttpRequest();
        xhr.open("POST", "https://token.mi9.com/", true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onreadystatechange = function () {
            if (xhr.readyState === XMLHttpRequest.DONE) {
                if (xhr.status === 200) {
                    let response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        let token = response.token;
                        let timestamp = response.timestamp;

                        // Step 2: Create Base64 payload
                        let payload = {
                            hl: "en",
                            package: packageName,
                            device: "phone",
                            arch: "arm64-v8a",
                            vc: vc,   
							device_id:"",							
                            sdk: 30,
                            timestamp: timestamp,
                        };
                        let base64Data = btoa(JSON.stringify(payload));

                        let eventSource = new EventSource(`https://api.mi9.com/get?token=${encodeURIComponent(token)}&data=${encodeURIComponent(base64Data)}`);

                        eventSource.onmessage = function (event) {
                            let data = JSON.parse(event.data);
                            progressBar.style.width = data.progress + "%";
                            progressBar.innerText = data.progress + "%";
                            resultsContainer.innerHTML = `<p>${data.status}</p>`;
                            if (data.progress >= 100 && data.html) {
                                eventSource.close();
                                progressContainer.style.display = "none";
                                resultsContainer.innerHTML = data.html;
                           
                                genButton.disabled = false;
                                genButton.style.backgroundColor = "";
                            }
                        };
                        eventSource.onerror = function () {
                            resultsContainer.innerHTML = "<p>An error occur#e10000. Please try again later.</p>";
                            progressContainer.style.display = "none";
                            eventSource.close();
                            genButton.disabled = false;
                            genButton.style.backgroundColor = "";
                        };
                    } else {
                        resultsContainer.innerHTML = "<p>Failed to generate token. Please try again later.</p>";
                        progressContainer.style.display = "none";
                        genButton.disabled = false;
                        genButton.style.backgroundColor = "";
                    }
                } else {
                    resultsContainer.innerHTML = "<p>An error occur#e10000 while creating the token. Please try again later.</p>";
                    progressContainer.style.display = "none";
                    genButton.disabled = false;
                    genButton.style.backgroundColor = "";
                }
            }
        };
        xhr.onerror = function () {
            resultsContainer.innerHTML = "<p>An error occur#e10000 while creating the token. Please try again later.</p>";
            progressContainer.style.display = "none";
            genButton.disabled = false;
            genButton.style.backgroundColor = "";
        };
        xhr.send(JSON.stringify({
            package: encodeURIComponent(packageName),
            device: "phone",
            arch: "arm64-v8a",
            vc:vc,
			device_id:"",
            sdk: 30,
        }));
    });
};


