    let e = document.getElementById("search-input"),
        t = document.getElementById("suggestions-box"),
        n = {};
    async function s() {
        let t = e.value.trim();
        if (t.length > 0) {
            if (n[t]) i(n[t]);
            else try {
                let s = await fetch(`https://suggest.mi9.com/?q=${encodeURIComponent(t)}&hl=en`),
                    a = await s.json();
                n[t] = a, i(a)
            } catch (r) {
                console.error("Error fetching suggestions:", r)
            }
        } else l()
    }

    function i(n) {
        l(), n.length > 0 ? (t.style.display = "block", n.forEach(n => {
            let s = document.createElement("li");
            s.textContent = n, s.addEventListener("click", () => {
                e.value = n, l()
            }), t.appendChild(s)
        })) : l()
    }

    function l() {
        t.innerHTML = "", t.style.display = "none"
    }
    e.addEventListener("input", s), e.addEventListener("focus", () => {
        let t = e.value.trim();
        t.length > 0 && s()
    }), document.addEventListener("click", e => {
        e.target.closest(".search-box") || l()
    })
});
(function() {
  const selector = document.querySelector('.language-selector');
