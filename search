<script>
function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text == null ? "" : String(text);
    return div.innerHTML;
}

function updateSearchHeading(query) {
    const safeQuery = (query || "").trim();
    const titleEl = document.getElementById("search-page-title");
    const descEl = document.getElementById("search-page-desc");
    const breadcrumbEl = document.getElementById("breadcrumb-current");

    if (!safeQuery) {
        if (titleEl) titleEl.textContent = "Search APK Files";
        if (descEl) {
            descEl.textContent = "Find Android apps and games by keyword. Browse APK search results, open package pages, and view available app details and updates.";
        }
        if (breadcrumbEl) breadcrumbEl.textContent = "Search";
        return;
    }

    if (titleEl) titleEl.textContent = 'Search results for "' + safeQuery + '"';
    if (descEl) {
        descEl.textContent = "Browse APK search results for " + safeQuery + ". Find Android apps and games, open package pages, and check app details and update information on MI9.";
    }
    if (breadcrumbEl) breadcrumbEl.textContent = safeQuery;
}

function setStatus(message) {
    const results = document.getElementById("results");
    results.innerHTML = '<div class="search-status">' + escapeHtml(message) + '</div>';
}

async function search() {
    const input = document.getElementById("search-input");
    if (!input) {
        setStatus("Search box not found.");
        return;
    }

    const rawQuery = input.value.trim();

    if (!rawQuery) {
        setStatus("Please enter a search query.");
        return;
    }

    const apiUrl = "https://search.mi9.com/?q=" + encodeURIComponent(rawQuery);
    setStatus("Searching APK files...");

    try {
        const response = await fetch(apiUrl, {
            method: "GET",
            headers: {
                "Accept": "application/json"
            }
        });

        if (!response.ok) {
            throw new Error("Failed to fetch search results");
        }

        const data = await response.json();
        displayResults(data, rawQuery);
    } catch (error) {
        console.error(error);
        setStatus("Unable to load search results right now. Please try again later.");
    }
}

function displayResults(items, query) {
    const results = document.getElementById("results");
    results.innerHTML = "";

    if (!Array.isArray(items) || items.length === 0) {
        results.innerHTML = '<div class="search-status">No APK results found for "' + escapeHtml(query) + '".</div>';
        return;
    }

    const fragment = document.createDocumentFragment();

    items.forEach(function(item) {
        const googleId = item && item.google_id ? String(item.google_id).trim() : "";
        const appName = item && item.app_name ? String(item.app_name).trim() : "";
        const icon = item && item.icon ? String(item.icon).trim() : "";

        if (!googleId || !appName) {
            return;
        }

        const cardWrap = document.createElement("div");
        cardWrap.className = "result-item";

        const link = document.createElement("a");
        link.className = "result-card";
        link.href = "/package/" + encodeURIComponent(googleId) + "/";
        link.title = appName;

        const thumb = document.createElement("div");
        thumb.className = "result-card__thumb";

        const img = document.createElement("img");
        img.loading = "lazy";
        img.decoding = "async";
        img.src = "https://play-lh.googleusercontent.com/" + icon + "=w512-rw";
        img.alt = appName;

        thumb.appendChild(img);

        const body = document.createElement("div");
        body.className = "result-card__body";

        const title = document.createElement("div");
        title.className = "result-card__title";
        title.textContent = appName;
        body.appendChild(title);   

        link.appendChild(thumb);
        link.appendChild(body);

        cardWrap.appendChild(link);
        fragment.appendChild(cardWrap);
    });

    if (!fragment.childNodes.length) {
        results.innerHTML = '<div class="search-status">No valid APK results found for "' + escapeHtml(query) + '".</div>';
        return;
    }

    results.appendChild(fragment);
}

(function initSearchPage() {
    const params = new URLSearchParams(window.location.search);
    const q = (params.get("q") || "").trim();

    updateSearchHeading(q);

    const input = document.getElementById("search-input");
    if (input && q) {
        input.value = q;
    }

    if (q) {
        search();
    } else {
        setStatus("Please enter a search query.");
    }
})();
